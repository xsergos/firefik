    "@tanstack/react-query": "^5.104.2",
    "@uiw/react-codemirror": "^4.25.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.4.4",
    "i18next-browser-languagedetector": "^8.2.1",
