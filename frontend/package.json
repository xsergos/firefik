    "@tanstack/react-query": "^5.108.4",
    "@uiw/react-codemirror": "^4.25.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^27.2.9",
    "i18next-browser-languagedetector": "^8.3.1",
    "lucide-react": "^1.81.0",
    "next-themes": "^0.4.6",
